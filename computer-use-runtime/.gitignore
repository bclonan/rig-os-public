# JavaScript dependencies, builds and test outputs.
node_modules/
dist/
.npm/
.cache/
.vite/
*.tsbuildinfo
coverage/
test-results*/
playwright-report/
blob-report/

# Python environments and caches. Keep learner/requirements.txt.
.venv/
.venv-desktop/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Native build outputs. Keep Cargo.lock and package-lock.json.
target/

# Private runtime stores, downloaded tools and temporary candidate workspaces.
/.data/
/.research/
/.tools/
/.candidates/
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.token
.evaluator.key
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Release archives and isolated installation checks.
/release/

# Regenerated by learner/generate.py during training.
/datasets/train/
/datasets/validation/

# Unpromoted training repeats. Keep the audited 17, 41 and 73 seed artifacts
# and the recorded-candidate example used by evaluation/recorded-learning.ts.
/models/candidate-*/
/models/offline-*/

# Downloaded upstream inspection copies. Keep provenance and license records.
/evidence/upstream/*
!/evidence/upstream/index.json

# Local desktop captures and inspection dumps. Controlled fixture evidence,
# the frozen audit, result reports and console preview remain versioned.
/evidence/**/*.bmp
/evidence/*-inspection.json
/evidence/native/inspect.json
/evidence/paint-shape-*
/evidence/save-dialog.json
/evidence/review-paint-dialog*
/evidence/review-paint-filename*
/evidence/review-paint-before.png
/evidence/candidate-path.txt
# Detailed completion attempts can contain personal app titles, captures and
# private diagnostic stores. Keep their hash references in reviewed docs.
/evidence/completion/
/evidence/oculix/*/

# Local logs, temporary files and editor settings. These also apply when this
# standalone package is copied outside the parent repository.
*.log
*.tmp
*.temp
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
